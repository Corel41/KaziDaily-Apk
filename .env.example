# MAPS_API_KEY: Required for Google Maps SDK for Android (interactive maps, location selection, and routing).
# Configure your Google Maps API key in the Secrets panel in AI Studio.
MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# CLOUDINARY: Cloud image hosting and dynamic CDN transformations for KaziDaily
CLOUDINARY_CLOUD_NAME=kazidaily-demo
CLOUDINARY_UPLOAD_PRESET=kazidaily_unsigned

# SUPABASE: Cloud PostgreSQL backend (PostgREST, Auth, Realtime)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here
